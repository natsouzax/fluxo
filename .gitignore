# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Secrets and credentials — this repo is public, keep every one of these out.
# `.env*.local` alone does NOT cover a plain `.env`.
.env
.env.*
!.env.example
secrets.json
credentials.json
# Google OAuth / Firebase service configs (contain client ids and API keys)
google-services.json
GoogleService-Info.plist
# EAS local credential store
credentials/
.easignore

# tests
coverage/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
